<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hptc_app_backgroud"
    tools:context=".DataExportActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="14"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10sp"
                android:paddingLeft="15sp"
                android:paddingBottom="5sp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_export_back"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    android:src="@drawable/back"/>
                <TextView
                    android:text="数据导出"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="23sp"
                    android:layout_marginLeft="20sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white"
                android:layout_marginTop="5sp"
                android:layout_marginBottom="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="88"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0sp"
                android:layout_weight="85"
                android:orientation="vertical"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="400sp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="@color/white"
                        android:text="工区设置"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="340sp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20sp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:text="工程名称: "/>
                    <EditText
                        android:id="@+id/et_project_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:textSize="16sp"
                        android:inputType="text"
                        android:layout_marginLeft="5sp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="400sp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20sp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="@color/white"
                        android:text="选择文件格式"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="340sp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20sp">
                    <CheckBox
                        android:id="@+id/file_format_csv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:theme="@style/MyCheckBox"
                        android:textSize="16sp"
                        android:text="CSV"/>
                    <CheckBox
                        android:id="@+id/file_format_txt"
                        android:layout_marginLeft="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:theme="@style/MyCheckBox"
                        android:textSize="16sp"
                        android:text="TXT"/>
                    <CheckBox
                        android:id="@+id/file_format_excel"
                        android:layout_marginLeft="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:theme="@style/MyCheckBox"
                        android:textSize="16sp"
                        android:text="EXCEL"/>
                    <CheckBox
                        android:id="@+id/file_format_word"
                        android:layout_marginLeft="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:theme="@style/MyCheckBox"
                        android:textSize="16sp"
                        android:text="Word"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20sp"
                    android:gravity="right"
                    android:layout_marginTop="15sp">
                </LinearLayout>
                <LinearLayout
                    android:layout_width="340sp"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="50sp"
                        android:layout_weight="1" />
                    <Button
                        android:id="@+id/btn_export"
                        android:layout_width="140sp"
                        android:layout_height="50sp"
                        android:textSize="18sp"
                        android:text="导出"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>